# Copy to .env and fill in. Read by `docker compose`.

# Host IP to publish on: the private-network IP of this machine that the reverse proxy can reach.
TANDEM_BIND=<private-ip>
TANDEM_PORT=3203

# Public URL the reverse proxy serves Tandem on (scheme + host, no trailing slash).
TANDEM_PUBLIC_URL=https://tandem.example.com

# Trust X-Forwarded-For from the proxy for the login rate limit (default true).
# TANDEM_TRUST_PROXY=true

# Docker bridge subnet; must not overlap other projects (sl-utils 172.28, atmmi 172.29).
# TANDEM_SUBNET=172.30.0.0/24
